---
import { Picture, getImage } from 'astro:assets';
import { images } from '../lib/images';
import { media,site } from '../lib/content.mjs';
const original=media.find(m=>m.id==='main-art');
const enlarged=await getImage({src:images['main-art'],width:1672,format:'webp',quality:90});
---
<header id="top" class="masthead shell-wide">
  <a class="masthead-mark" href="#top" aria-label="Back to the beginning"><span class="paired-mark" aria-hidden="true"></span><span>THE UNRESOLVED RECORD</span></a>
  <nav aria-label="Primary navigation"><a href="#chronicle">Chronicle</a><a href="#timeline">Timeline</a><a href="#three-demands">Demands</a><a href="#sources">Sources</a></nav>
</header>
<section class="hero shell-wide" aria-labelledby="site-title">
  <div class="hero-title"><h1 id="site-title">{site.title}</h1><span class="eyebrow">SEPTEMBER 2026</span></div>
  <figure class="hero-plate">
    <a href={enlarged.src} aria-label="Inspect the complete opening illustration">
      <Picture src={images['main-art']} alt={original.alt} formats={['avif','webp']} fallbackFormat="jpg" widths={[480,768,1100,1376,1672]} sizes="(max-width: 799px) 100vw, (max-width: 1664px) calc(100vw - 64px), 1600px" width={1672} height={941} quality={78} loading="eager" fetchpriority="high" />
    </a>
    <figcaption><span>ILLUSTRATION <span class="caption-separator">/</span> THE TURKO–PARADOX WAR</span><span>21—26 SEPTEMBER <span class="caption-separator">/</span> RECORD COVERED</span></figcaption>
  </figure>
</section>
